# ---------------------------------------------------------------- required
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service role key (Dashboard -> Project Settings -> API -> service_role).
# NOT the anon/publishable key: the worker writes, and news_articles is
# write-protected by RLS. Treat this like a password, never ship it to the
# browser bundle, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- optional
# Unauthenticated GitHub search allows 10 req/min; a fine-grained token with
# no scopes ("public repositories, read-only") raises it to 30 req/min.
GITHUB_TOKEN=

# Every 6 hours, on the hour.
CRON_SCHEDULE=0 */6 * * *

# Daily prune, 03:15.
PRUNE_SCHEDULE=15 3 * * *

# Timezone the cron expressions are evaluated in.
TZ=Asia/Kolkata

# Drop articles published more than this many days ago.
RETENTION_DAYS=30

# Fetch everything once as soon as the process starts.
RUN_ON_STARTUP=true

# Items kept per source per run.
PER_SOURCE_LIMIT=20

# debug | info | warn | error
LOG_LEVEL=info
